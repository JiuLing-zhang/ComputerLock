@page "/about"

<MudText Typo="Typo.h6" Class="mb-3">@(Lang["About"])</MudText>

<div class="d-flex flex-column align-center mb-4">

    <MudText Typo="Typo.h6" Class="mb-2" Color="Color.Primary">@Lang["Title"]</MudText>

    <MudPaper Elevation="0" Class="d-flex align-center">
        <MudChip T="string" Variant="Variant.Outlined" Color="Color.Inherit" Label="true" Size="Size.Small"> @_version</MudChip>
        <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Inherit" OnClick="OpenVersionHistory">
            @Lang["VersionHistory"]
        </MudButton>
    </MudPaper>

    <MudDivider Class="my-5" />

    <MudCard Class="mb-6">
        <MudCardContent>
            @* 停止维护通知 *@
            <MudAlert Severity="Severity.Warning" Variant="Variant.Text" Class="mb-4">
                「透明锁屏」已进入最终版本，不再进行功能更新或问题修复，但现有功能可继续正常使用。感谢大家一路支持与陪伴！开源仓库后续也可能停止公开访问。
            </MudAlert>

            <MudAlert Severity="Severity.Success" Variant="Variant.Text" Class="mb-4">
                全新版本「影子锁屏」已正式上线，承载更多功能与优化体验。依然免费提供给所有用户，同时作为闭源产品发布以保证持续更新与功能迭代。
            </MudAlert>

            @* 感谢信息 *@
            <MudAlert Severity="Severity.Info" Icon="@Icons.Material.Filled.Favorite" Variant="Variant.Outlined">
                感谢大家一路以来的支持与陪伴。
            </MudAlert>
        </MudCardContent>
    </MudCard>
    
    @* 关于影子锁屏 *@
    <MudCard Style="width: 100%;">
        <MudCardContent>
            <MudText Typo="Typo.h6" Color="Color.Secondary" Class="mb-3">
                「影子锁屏」升级亮点
            </MudText>
            <MudAlert Severity="Severity.Success"
                      Icon="@Icons.Material.Filled.ColorLens"
                      Dense="true"
                      Class="mb-1">
                基于 .NET 10 开发，全新 Windows 11 风格界面设计
            </MudAlert>
            <MudAlert Severity="Severity.Success"
                      Icon="@Icons.Material.Filled.PersonalVideo"
                      Dense="true"
                      Class="mb-1">
                新增：支持黑屏锁屏模式
            </MudAlert>
            <MudAlert Severity="Severity.Success"
                      Icon="@Icons.Material.Filled.Camera"
                      Dense="true"
                      Class="mb-1">
                新增：支持锁屏水印功能
            </MudAlert>
            <MudAlert Severity="Severity.Success"
                      Icon="@Icons.Material.Filled.VerifiedUser"
                      Dense="true"
                      Class="mb-1">
                新增：支持 Windows 账户解锁（Windows Hello）
            </MudAlert>
            <MudAlert Severity="Severity.Success"
                      Icon="@Icons.Material.Filled.PersonOff"
                      Dense="true"
                      Class="mb-2">
                修改：取消管理员权限要求，默认普通权限运行
            </MudAlert>
             
            @* Standalone *@
            <MudButton Href="https://hub.jiuling.cc/api/apps/download/08a57cf8f29e442ca2bdaaf2ad947ea9"
                       Class="mb-2"
                       Target="_blank"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       StartIcon="@Icons.Material.Filled.Public">
                下载「影子锁屏」
            </MudButton>
            <MudAlert Severity="Severity.Warning"
                      Class="mb-1"
                      Icon="@Icons.Material.Filled.LocalFireDepartment"
                      Dense="true">
                需要 Windows 10 或更高版本才能运行
            </MudAlert>
            <MudAlert Severity="Severity.Warning"
                      Icon="@Icons.Custom.Brands.MicrosoftVisualStudio"
                      Dense="true">
                运行前需安装 .NET 10 Runtime（未安装时程序会自动提示下载）
            </MudAlert>
        </MudCardContent>
    </MudCard>

</div>


