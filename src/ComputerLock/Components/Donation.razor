﻿<MudDialog>
    <DialogContent>
        <MudPaper Elevation="0" Class="d-flex flex-column align-center">

            <MudPaper Class="d-flex justify-center mb-2" Elevation="0" Style="position: relative; width: 100%;">
                <MudText Typo="Typo.subtitle1" Color="Color.Secondary">
                    支持作者
                </MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Close"
                               Color="Color.Inherit"
                               Size="Size.Small"
                               OnClick="Close"
                               Style="position: absolute; top: -5px; right: -20px;" />
            </MudPaper>
             
            <div style="width:200px; height:200px; overflow:hidden;">
                <MudImage Src="images/wxPay.jpg"
                          Elevation="4"
                          style="
                width: 443px;      /* 原图1329 缩小到 1/3（因为600→200=1/3） */
                height: 443px;
                margin-left: -123px; /* 370/3  定位偏移（自动跟着缩放）*/
                margin-top: -63px;   /* 190/3  定位偏移 */
                object-fit: none;
                border-radius:4px;
                " />
            </div>
            
            <MudText Typo="Typo.body2" Class="mt-3 mb-6" Style="color: #07C160">
                微信官方赞赏码
            </MudText>
            
            <MudText Typo="Typo.body1" Class="my-2">
                扫一扫，输入任意金额赞赏
            </MudText>

            <MudText Typo="Typo.subtitle2" Class="my-2" Style="opacity: 0.7">
                由衷感谢每一份支持
            </MudText>
        </MudPaper>
    </DialogContent>
</MudDialog>
